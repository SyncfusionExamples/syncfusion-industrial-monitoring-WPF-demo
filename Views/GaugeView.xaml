<UserControl x:Class="Syncfusion.IndustrialMonitoring.POC.Views.GaugeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"           
             xmlns:syncfusion="clr-namespace:Syncfusion.UI.Xaml.Gauges;assembly=Syncfusion.SfGauge.Wpf"
             Background="{DynamicResource CardBackground}">
    <Grid>
        <StackPanel Orientation="Vertical" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Margin="0">
            <!-- Horizontal Linear Gauge for Temperature -->
            <TextBlock Text="درجة الحرارة (م°)" FontWeight="Bold" FontSize="12" Margin="0,5,0,4" />
            <syncfusion:SfLinearGauge Orientation="Horizontal" Width="Auto" Height="60" Margin="0,0,0,8">
                <syncfusion:SfLinearGauge.MainScale>
                    <syncfusion:LinearScale Minimum="0" Maximum="100" Interval="20"
                                           ScaleBarStroke="{DynamicResource CardBorder}" LabelStroke="{DynamicResource TextSecondary}"
                                           MajorTickStroke="Gray" MajorTickSize="10"
                                           MinorTickStroke="Gray" MinorTickSize="5"
                                           MinorTicksPerInterval="1"
                                           ScaleBarSize="8"
                                           LabelPostfix=" م°">
                        <syncfusion:LinearScale.Ranges>
                            <syncfusion:LinearRange StartValue="0" EndValue="70" RangeStroke="Green" StartWidth="8" EndWidth="8" />
                            <syncfusion:LinearRange StartValue="70" EndValue="90" RangeStroke="Orange" StartWidth="8" EndWidth="8" />
                            <syncfusion:LinearRange StartValue="90" EndValue="100" RangeStroke="Red" StartWidth="8" EndWidth="8" />
                        </syncfusion:LinearScale.Ranges>
                        <syncfusion:LinearScale.Pointers>
                            <syncfusion:LinearPointer PointerType="BarPointer"
                                                     Value="{Binding GaugeVM.TemperatureValue}"
                                                     BarPointerStroke="#FF6B6B"
                                                     BarPointerStrokeThickness="8"
                                                     EnableAnimation="True"
                                                     AnimationDuration="300"/>
                        </syncfusion:LinearScale.Pointers>
                    </syncfusion:LinearScale>
                </syncfusion:SfLinearGauge.MainScale>
            </syncfusion:SfLinearGauge>

            <!-- Horizontal Linear Gauge for Pressure -->
            <TextBlock Text="الضغط (بار)" FontWeight="Bold" FontSize="12" Margin="0,5,0,4" />
            <syncfusion:SfLinearGauge Orientation="Horizontal" Width="Auto" Height="60">
                <syncfusion:SfLinearGauge.MainScale>
                    <syncfusion:LinearScale Minimum="0" Maximum="100" Interval="20"
                                           ScaleBarStroke="{DynamicResource CardBorder}" LabelStroke="{DynamicResource TextSecondary}"
                                           MajorTickStroke="Gray" MajorTickSize="10"
                                           MinorTickStroke="Gray" MinorTickSize="5"
                                           MinorTicksPerInterval="1"
                                           ScaleBarSize="8"
                                           LabelPostfix=" بار">
                        <syncfusion:LinearScale.Ranges>
                            <syncfusion:LinearRange StartValue="0" EndValue="75" RangeStroke="Green" StartWidth="8" EndWidth="8" />
                            <syncfusion:LinearRange StartValue="75" EndValue="95" RangeStroke="Orange" StartWidth="8" EndWidth="8" />
                            <syncfusion:LinearRange StartValue="95" EndValue="100" RangeStroke="Red" StartWidth="8" EndWidth="8" />
                        </syncfusion:LinearScale.Ranges>
                        <syncfusion:LinearScale.Pointers>
                            <syncfusion:LinearPointer PointerType="BarPointer"
                                                     Value="{Binding GaugeVM.PressureValue}"
                                                     BarPointerStroke="#36D1DC"
                                                     BarPointerStrokeThickness="8"
                                                     EnableAnimation="True"
                                                     AnimationDuration="300"/>
                        </syncfusion:LinearScale.Pointers>
                    </syncfusion:LinearScale>
                </syncfusion:SfLinearGauge.MainScale>
            </syncfusion:SfLinearGauge>
        </StackPanel>
    </Grid>
</UserControl>
