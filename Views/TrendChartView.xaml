<UserControl x:Class="Syncfusion.IndustrialMonitoring.POC.Views.TrendChartView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Syncfusion.IndustrialMonitoring.POC"
             xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
             Background="{DynamicResource CardBackground}">
    <UserControl.Resources>
        <DataTemplate x:Key="ImageIconTemplate">
            <Grid Width="16" Height="16">
                <Path Data="M21,19V5c0,-1.1 -0.9,-2 -2,-2H5C3.9,3 3,3.9 3,5v14c0,1.1 0.9,2 2,2h14c1.1,0 2,-0.9 2,-2zM8.5,13.5l2.5,3.01L14.5,12l4.5,6H5l3.5,-4.5z"
                      Fill="#FFFFFF" Stretch="Fill"/>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="10,8,10,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="تحليل الاتجاه" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimary}"/>
            <syncfusion:ButtonAdv Grid.Column="1" x:Name="ExportImageButton"
                                  Label="تصدير الصورة"
                                  Height="32" Width="130"
                                  VerticalAlignment="Center" HorizontalAlignment="Right"
                                  SizeMode="Normal" IconTemplate="{StaticResource ImageIconTemplate}"
                                  Click="OnExportImageClick"/>
        </Grid>

        <TabControl Grid.Row="1" Margin="5,0,5,5">
            <!-- Live trend -->
            <TabItem Header="مباشر">
                <syncfusion:SfChart x:Name="TrendChart" Margin="5">
                    <!-- Category axis spaces points evenly per update, so the chart scrolls
                         one slot per tick and the update interval is visible. -->
                    <syncfusion:SfChart.PrimaryAxis>
                        <syncfusion:CategoryAxis LabelFormat="HH:mm:ss" ShowGridLines="False" />
                    </syncfusion:SfChart.PrimaryAxis>
                    <syncfusion:SfChart.SecondaryAxis>
                        <syncfusion:NumericalAxis />
                    </syncfusion:SfChart.SecondaryAxis>
                    <syncfusion:LineSeries ItemsSource="{Binding TrendVM.TrendData}"
                                           XBindingPath="Timestamp" 
                                           YBindingPath="Value"
                                           StrokeThickness="2"
                                           Interior="#0066CC">
                    </syncfusion:LineSeries>
                </syncfusion:SfChart>
            </TabItem>

            <!-- Historical trend from the database: mouse wheel / selection to zoom, drag to pan,
                 hover for values. All built-in SfChart behaviours. -->
            <TabItem Header="سجل تاريخي (8 ساعات)">
                <syncfusion:SfChart x:Name="HistoryChart" Margin="5">
                    <syncfusion:SfChart.PrimaryAxis>
                        <syncfusion:DateTimeAxis LabelFormat="HH:mm" ShowGridLines="False" />
                    </syncfusion:SfChart.PrimaryAxis>
                    <syncfusion:SfChart.SecondaryAxis>
                        <syncfusion:NumericalAxis Minimum="0" Maximum="100" />
                    </syncfusion:SfChart.SecondaryAxis>
                    <syncfusion:SfChart.Legend>
                        <syncfusion:ChartLegend DockPosition="Top" />
                    </syncfusion:SfChart.Legend>
                    <syncfusion:SfChart.Behaviors>
                        <syncfusion:ChartZoomPanBehavior EnableMouseWheelZooming="True" EnablePanning="True"
                                                         EnableSelectionZooming="True" ZoomMode="X" ResetOnDoubleTap="True" />
                        <syncfusion:ChartTrackBallBehavior ShowLine="True" />
                    </syncfusion:SfChart.Behaviors>
                    <syncfusion:FastLineSeries Label="درجة الحرارة" ItemsSource="{Binding TrendVM.TemperatureHistory}"
                                               XBindingPath="Timestamp" YBindingPath="Value" Interior="#0066CC" />
                    <syncfusion:FastLineSeries Label="الضغط" ItemsSource="{Binding TrendVM.PressureHistory}"
                                               XBindingPath="Timestamp" YBindingPath="Value" Interior="#00897B" />
                    <syncfusion:FastLineSeries Label="الرطوبة" ItemsSource="{Binding TrendVM.HumidityHistory}"
                                               XBindingPath="Timestamp" YBindingPath="Value" Interior="#EF6C00" />
                </syncfusion:SfChart>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
