<UserControl x:Class="Syncfusion.IndustrialMonitoring.POC.Views.TrendChartView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Syncfusion.IndustrialMonitoring.POC"
             xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
             Background="White">
    <UserControl.Resources>
        <DataTemplate x:Key="ImageIconTemplate">
            <Grid Width="16" Height="16">
                <Path Data="M21,19V5c0,-1.1 -0.9,-2 -2,-2H5C3.9,3 3,3.9 3,5v14c0,1.1 0.9,2 2,2h14c1.1,0 2,-0.9 2,-2zM8.5,13.5l2.5,3.01L14.5,12l4.5,6H5l3.5,-4.5z"
                      Fill="#FFFFFF" Stretch="Fill"/>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="10,8,10,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="تحليل الاتجاه" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="#1A1A1A"/>
            <syncfusion:ButtonAdv Grid.Column="1" x:Name="ExportImageButton"
                                  Label="تصدير الصورة"
                                  Height="32" Width="130"
                                  VerticalAlignment="Center" HorizontalAlignment="Right"
                                  SizeMode="Normal" IconTemplate="{StaticResource ImageIconTemplate}"
                                  Click="OnExportImageClick"/>
        </Grid>

        <!-- Chart -->
        <syncfusion:SfChart x:Name="TrendChart" Grid.Row="1" Margin="5">
            <syncfusion:LineSeries ItemsSource="{Binding TrendVM.TrendData}"
                                   XBindingPath="Timestamp" 
                                   YBindingPath="Value"
                                   StrokeThickness="2"
                                   Interior="#0066CC">
            </syncfusion:LineSeries>
        </syncfusion:SfChart>
    </Grid>
</UserControl>
