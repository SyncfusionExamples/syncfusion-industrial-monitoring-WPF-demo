<UserControl x:Class="Syncfusion.IndustrialMonitoring.POC.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Syncfusion.IndustrialMonitoring.POC.Views"
             xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
             FlowDirection="{Binding FlowDirection}"
             Background="#F5F5F5">
    <UserControl.Resources>
        <!-- RTL Toggle Icon -->
        <DataTemplate x:Key="RtlIconTemplate">
            <Grid Width="16" Height="16">
                <Path Data="M11,7L9.6,8.4l2.6,2.6H2v2h10.2l-2.6,2.6L11,17l5,-5l-5,-5zM20,19h-8v2h8c1.1,0 2,-0.9 2,-2V5c0,-1.1 -0.9,-2 -2,-2h-8v2h8v14z"
                      Fill="#FFFFFF" Stretch="Fill"/>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Grid.Row="0" Background="DarkSlateGray" Padding="10">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <CheckBox IsChecked="{Binding IsLiveUpdating}" VerticalAlignment="Center" Margin="0,0,10,0">
                    <TextBlock Text="مباشر" Foreground="White" VerticalAlignment="Center"/>
                </CheckBox>
                <syncfusion:ButtonAdv Command="{Binding ToggleRtlCommand}" Label="تبديل الاتجاه" Height="32" Width="120" VerticalAlignment="Center" SizeMode="Normal" IconTemplate="{StaticResource RtlIconTemplate}" />
            </StackPanel>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="35*"/>
                <RowDefinition Height="30*"/>
                <RowDefinition Height="35*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Chart (top) -->
            <Border Grid.Row="0" Background="White" Margin="10" CornerRadius="4" BorderThickness="1" BorderBrush="#E0E0E0">
                <local:TrendChartView />
            </Border>

            <!-- Status + Bullet Graphs + Gauges (middle) - 3-column split -->
            <Grid Grid.Row="1" Margin="10,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- System Status Header (left) -->
                <Border Grid.Column="0" Background="White" CornerRadius="4" BorderThickness="1" BorderBrush="#E0E0E0" Padding="12" Margin="0,0,5,0">
                    <StackPanel>
                        <TextBlock Text="حالة النظام" FontSize="13" FontWeight="Bold" Foreground="#1A1A1A" Margin="0,0,0,10" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="آخر تحديث: " FontSize="10" Foreground="#666" />
                            <TextBlock Text="{Binding StatusSummary.LastUpdateTime}" FontSize="10" Foreground="#666" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Bullet Graphs (center) - one status per row, with scroller -->
                <Border Grid.Column="1" Background="White" CornerRadius="4" BorderThickness="1" BorderBrush="#E0E0E0" Margin="5,0,5,0" Padding="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Good Sensors -->
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="✓ مستشعرات جيدة" FontSize="11" Margin="0,0,10,0" Foreground="#2E7D32" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <syncfusion:SfBulletGraph MinHeight="50" Grid.Row="0" Grid.Column="1" Minimum="0" Maximum="10" Interval="2"
                                                      FeaturedMeasure="{Binding StatusSummary.GoodSensorsCount}"
                                                      FeaturedMeasureBarStroke="#2E7D32"
                                                      FeaturedMeasureBarStrokeThickness="12"
                                                      QualitativeRangesSize="20"
                                                      Height="50">
                            <syncfusion:SfBulletGraph.QualitativeRanges>
                                <syncfusion:QualitativeRange RangeEnd="4" RangeStroke="#C8E6C9"/>
                                <syncfusion:QualitativeRange RangeEnd="7" RangeStroke="#A5D6A7"/>
                                <syncfusion:QualitativeRange RangeEnd="10" RangeStroke="#81C784"/>
                            </syncfusion:SfBulletGraph.QualitativeRanges>
                        </syncfusion:SfBulletGraph>

                        <!-- Bad Sensors -->
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="✗ مستشعرات سيئة" FontSize="11" Margin="0,0,10,0" Foreground="#C62828" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <syncfusion:SfBulletGraph MinHeight="50" Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="10" Interval="2"
                                                      FeaturedMeasure="{Binding StatusSummary.BadSensorsCount}"
                                                      FeaturedMeasureBarStroke="#C62828"
                                                      FeaturedMeasureBarStrokeThickness="12"
                                                      QualitativeRangesSize="20"
                                                      Height="50">
                            <syncfusion:SfBulletGraph.QualitativeRanges>
                                <syncfusion:QualitativeRange RangeEnd="4" RangeStroke="#FFCDD2"/>
                                <syncfusion:QualitativeRange RangeEnd="7" RangeStroke="#EF9A9A"/>
                                <syncfusion:QualitativeRange RangeEnd="10" RangeStroke="#E57373"/>
                            </syncfusion:SfBulletGraph.QualitativeRanges>
                        </syncfusion:SfBulletGraph>

                        <!-- Stale Sensors -->
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="⚠ مستشعرات قديمة" FontSize="11" Margin="0,0,10,0" Foreground="#EF6C00" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <syncfusion:SfBulletGraph MinHeight="50" Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="10" Interval="2"
                                                      FeaturedMeasure="{Binding StatusSummary.StaleSensorsCount}"
                                                      FeaturedMeasureBarStroke="#EF6C00"
                                                      FeaturedMeasureBarStrokeThickness="12"
                                                      QualitativeRangesSize="20"
                                                      Height="50">
                            <syncfusion:SfBulletGraph.QualitativeRanges>
                                <syncfusion:QualitativeRange RangeEnd="4" RangeStroke="#FFE0B2"/>
                                <syncfusion:QualitativeRange RangeEnd="7" RangeStroke="#FFCC80"/>
                                <syncfusion:QualitativeRange RangeEnd="10" RangeStroke="#FFB74D"/>
                            </syncfusion:SfBulletGraph.QualitativeRanges>
                        </syncfusion:SfBulletGraph>

                        <!-- Active Alarms -->
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="🔴 إنذارات نشطة" FontSize="11" FontWeight="SemiBold" Margin="0,0,10,0" Foreground="#B71C1C" VerticalAlignment="Center"/>
                        <syncfusion:SfBulletGraph MinHeight="50" Grid.Row="3" Grid.Column="1" Minimum="0" Maximum="10" Interval="2"
                                                      FeaturedMeasure="{Binding StatusSummary.ActiveAlarmsCount}"
                                                      FeaturedMeasureBarStroke="#B71C1C"
                                                      FeaturedMeasureBarStrokeThickness="12"
                                                      QualitativeRangesSize="20"
                                                      Height="50">
                            <syncfusion:SfBulletGraph.QualitativeRanges>
                                <syncfusion:QualitativeRange RangeEnd="4" RangeStroke="#FFEBEE"/>
                                <syncfusion:QualitativeRange RangeEnd="7" RangeStroke="#FFCDD2"/>
                                <syncfusion:QualitativeRange RangeEnd="10" RangeStroke="#EF9A9A"/>
                            </syncfusion:SfBulletGraph.QualitativeRanges>
                        </syncfusion:SfBulletGraph>
                    </Grid>
                </Border>

                <!-- Gauges (right) -->
                <Border Grid.Column="2" Background="White" CornerRadius="4" BorderThickness="1" BorderBrush="#E0E0E0" Padding="10" MinWidth="300">
                    <local:GaugeView />
                </Border>
            </Grid>

            <!-- Alarm Grid (bottom) -->
            <Border Grid.Row="2" Background="White" Margin="10,5" CornerRadius="4" BorderThickness="1" BorderBrush="#E0E0E0" Padding="10">
                <local:AlarmGridView />
            </Border>
        </Grid>
    </Grid>
</UserControl>
