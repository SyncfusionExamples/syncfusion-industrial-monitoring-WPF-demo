<UserControl x:Class="Syncfusion.IndustrialMonitoring.POC.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Syncfusion.IndustrialMonitoring.POC.Views"
             xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
             FlowDirection="{Binding FlowDirection}"
             Background="{DynamicResource PageBackground}">
    <UserControl.Resources>
        <!-- RTL Toggle Icon -->
        <DataTemplate x:Key="RtlIconTemplate">
            <Grid Width="16" Height="16">
                <Path Data="M11,7L9.6,8.4l2.6,2.6H2v2h10.2l-2.6,2.6L11,17l5,-5l-5,-5zM20,19h-8v2h8c1.1,0 2,-0.9 2,-2V5c0,-1.1 -0.9,-2 -2,-2h-8v2h8v14z"
                      Fill="#FFFFFF" Stretch="Fill"/>
            </Grid>
        </DataTemplate>
        <!-- Theme Icon -->
        <DataTemplate x:Key="ThemeIconTemplate">
            <Grid Width="16" Height="16">
                <Path Data="M12,3c-4.97,0 -9,4.03 -9,9s4.03,9 9,9s9,-4.03 9,-9s-4.03,-9 -9,-9zM12,19V5c3.86,0 7,3.14 7,7s-3.14,7 -7,7z"
                      Fill="#FFFFFF" Stretch="Fill"/>
            </Grid>
        </DataTemplate>
        <!-- Report Icon -->
        <DataTemplate x:Key="ReportIconTemplate">
            <Grid Width="16" Height="16">
                <Path Data="M14,2H6C4.9,2 4,2.9 4,4v16c0,1.1 0.9,2 2,2h12c1.1,0 2,-0.9 2,-2V8l-6,-6zM16,18H8v-2h8v2zM16,14H8v-2h8v2zM13,9V3.5L18.5,9H13z"
                      Fill="#FFFFFF" Stretch="Fill"/>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Grid.Row="0" Background="DarkSlateGray" Padding="10">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <CheckBox Name="isLiveUpdating" IsChecked="{Binding IsLiveUpdating}" VerticalAlignment="Center" Margin="0,0,10,0">
                    <TextBlock Text="مباشر" Foreground="White" VerticalAlignment="Center"/>
                </CheckBox>
                <TextBlock Text="الفاصل الزمني (مللي ثانية):" Foreground="White" VerticalAlignment="Center" Margin="0,0,5,0" />
                <Slider x:Name="updateIntervalSlider" Value="{Binding UpdateInterval, Mode=TwoWay}" Minimum="50" Maximum="1000"
                        TickFrequency="50" IsSnapToTickEnabled="True" IsMoveToPointEnabled="True"
                        Width="150" VerticalAlignment="Center" Margin="0,0,5,0" />
                <TextBlock Text="{Binding UpdateInterval}" Foreground="White" VerticalAlignment="Center" MinWidth="35" Margin="0,0,10,0" />
                <syncfusion:ButtonAdv Command="{Binding ToggleRtlCommand}" Label="تبديل الاتجاه" Height="32" Width="120" VerticalAlignment="Center" SizeMode="Normal" IconHeight="0" IconWidth="0"/>
                <syncfusion:ButtonAdv x:Name="toggleThemeButton" Command="{Binding ToggleThemeCommand}" Label="فاتح / داكن" Height="32" Width="110" Margin="10,0,0,0" VerticalAlignment="Center" SizeMode="Normal" IconHeight="0" IconWidth="0"/>
                <syncfusion:ButtonAdv x:Name="exportPdfReportButton" Command="{Binding ExportPdfReportCommand}" Label="تقرير PDF" Height="32" Width="110" Margin="10,0,0,0" VerticalAlignment="Center" SizeMode="Normal" IconHeight="0" IconWidth="0"/>
                <syncfusion:ButtonAdv x:Name="exportExcelReportButton" Command="{Binding ExportExcelReportCommand}" Label="تقرير Excel" Height="32" Width="110" Margin="10,0,0,0" VerticalAlignment="Center" SizeMode="Normal" IconHeight="0" IconWidth="0"/>
            </StackPanel>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="35*"/>
                <RowDefinition Height="30*"/>
                <RowDefinition Height="35*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Chart (top) -->
            <Border Grid.Row="0" Background="{DynamicResource CardBackground}" Margin="10" CornerRadius="4" BorderThickness="1" BorderBrush="{DynamicResource CardBorder}">
                <local:TrendChartView />
            </Border>

            <!-- Status + Bullet Graphs + Gauges (middle) - 3-column split -->
            <Grid Grid.Row="1" Margin="10,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- System Status Header (left) -->
                <Border Grid.Column="0" Background="{DynamicResource CardBackground}" CornerRadius="4" BorderThickness="1" BorderBrush="{DynamicResource CardBorder}" Padding="12" Margin="0,0,5,0">
                    <StackPanel>
                        <TextBlock Text="حالة النظام" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,10" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="آخر تحديث: " FontSize="10" Foreground="{DynamicResource TextSecondary}" />
                            <TextBlock Text="{Binding StatusSummary.LastUpdateTime}" FontSize="10" Foreground="{DynamicResource TextSecondary}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Bullet Graphs (center) - one status per row, with scroller -->
                <Border Grid.Column="1" Background="{DynamicResource CardBackground}" CornerRadius="4" BorderThickness="1" BorderBrush="{DynamicResource CardBorder}" Margin="5,0,5,0" Padding="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Good Sensors -->
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="✓ مستشعرات جيدة" FontSize="11" Margin="0,0,10,0" Foreground="#2E7D32" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <syncfusion:SfBulletGraph MinHeight="50" Grid.Row="0" Grid.Column="1" Minimum="0" Maximum="10" Interval="2"
                                                      FeaturedMeasure="{Binding StatusSummary.GoodSensorsCount}"
                                                      FeaturedMeasureBarStroke="#2E7D32"
                                                      FeaturedMeasureBarStrokeThickness="12"
                                                      QualitativeRangesSize="20"
                                                      Height="50">
                            <syncfusion:SfBulletGraph.QualitativeRanges>
                                <syncfusion:QualitativeRange RangeEnd="4" RangeStroke="#C8E6C9"/>
                                <syncfusion:QualitativeRange RangeEnd="7" RangeStroke="#A5D6A7"/>
                                <syncfusion:QualitativeRange RangeEnd="10" RangeStroke="#81C784"/>
                            </syncfusion:SfBulletGraph.QualitativeRanges>
                        </syncfusion:SfBulletGraph>

                        <!-- Bad Sensors -->
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="✗ مستشعرات سيئة" FontSize="11" Margin="0,0,10,0" Foreground="#C62828" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <syncfusion:SfBulletGraph MinHeight="50" Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="10" Interval="2"
                                                      FeaturedMeasure="{Binding StatusSummary.BadSensorsCount}"
                                                      FeaturedMeasureBarStroke="#C62828"
                                                      FeaturedMeasureBarStrokeThickness="12"
                                                      QualitativeRangesSize="20"
                                                      Height="50">
                            <syncfusion:SfBulletGraph.QualitativeRanges>
                                <syncfusion:QualitativeRange RangeEnd="4" RangeStroke="#FFCDD2"/>
                                <syncfusion:QualitativeRange RangeEnd="7" RangeStroke="#EF9A9A"/>
                                <syncfusion:QualitativeRange RangeEnd="10" RangeStroke="#E57373"/>
                            </syncfusion:SfBulletGraph.QualitativeRanges>
                        </syncfusion:SfBulletGraph>

                        <!-- Stale Sensors -->
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="⚠ مستشعرات قديمة" FontSize="11" Margin="0,0,10,0" Foreground="#EF6C00" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <syncfusion:SfBulletGraph MinHeight="50" Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="10" Interval="2"
                                                      FeaturedMeasure="{Binding StatusSummary.StaleSensorsCount}"
                                                      FeaturedMeasureBarStroke="#EF6C00"
                                                      FeaturedMeasureBarStrokeThickness="12"
                                                      QualitativeRangesSize="20"
                                                      Height="50">
                            <syncfusion:SfBulletGraph.QualitativeRanges>
                                <syncfusion:QualitativeRange RangeEnd="4" RangeStroke="#FFE0B2"/>
                                <syncfusion:QualitativeRange RangeEnd="7" RangeStroke="#FFCC80"/>
                                <syncfusion:QualitativeRange RangeEnd="10" RangeStroke="#FFB74D"/>
                            </syncfusion:SfBulletGraph.QualitativeRanges>
                        </syncfusion:SfBulletGraph>

                        <!-- Active Alarms -->
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="🔴 إنذارات نشطة" FontSize="11" FontWeight="SemiBold" Margin="0,0,10,0" Foreground="#B71C1C" VerticalAlignment="Center"/>
                        <syncfusion:SfBulletGraph MinHeight="50" Grid.Row="3" Grid.Column="1" Minimum="0" Maximum="10" Interval="2"
                                                      FeaturedMeasure="{Binding StatusSummary.ActiveAlarmsCount}"
                                                      FeaturedMeasureBarStroke="#B71C1C"
                                                      FeaturedMeasureBarStrokeThickness="12"
                                                      QualitativeRangesSize="20"
                                                      Height="50">
                            <syncfusion:SfBulletGraph.QualitativeRanges>
                                <syncfusion:QualitativeRange RangeEnd="4" RangeStroke="#FFEBEE"/>
                                <syncfusion:QualitativeRange RangeEnd="7" RangeStroke="#FFCDD2"/>
                                <syncfusion:QualitativeRange RangeEnd="10" RangeStroke="#EF9A9A"/>
                            </syncfusion:SfBulletGraph.QualitativeRanges>
                        </syncfusion:SfBulletGraph>
                    </Grid>
                </Border>

                <!-- Gauges (right) -->
                <Border Grid.Column="2" Background="{DynamicResource CardBackground}" CornerRadius="4" BorderThickness="1" BorderBrush="{DynamicResource CardBorder}" Padding="10" MinWidth="300">
                    <local:GaugeView />
                </Border>
            </Grid>

            <!-- Alarm Grid (bottom) -->
            <Border Grid.Row="2" Background="{DynamicResource CardBackground}" Margin="10,5" CornerRadius="4" BorderThickness="1" BorderBrush="{DynamicResource CardBorder}" Padding="10">
                <local:AlarmGridView />
            </Border>
        </Grid>
    </Grid>
</UserControl>
