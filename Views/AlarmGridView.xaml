<UserControl x:Class="Syncfusion.IndustrialMonitoring.POC.Views.AlarmGridView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
             Background="White">
    <UserControl.Resources>
        <DataTemplate x:Key="ExcelIconTemplate">
            <Grid Width="16" Height="16">
                <Path Data="M13,2H6C4.9,2 4,2.9 4,4V20c0,1.1 0.9,2 2,2h12c1.1,0 2,-0.9 2,-2V8l-7,-6zM6,20V4h6v6h6v10H6zM8,12h8v2h-8v-2z"
                      Fill="#FFFFFF" Stretch="Fill"/>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="5,8,5,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="سجل الإنذارات" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="#1A1A1A"/>
            <syncfusion:ButtonAdv Grid.Column="1" x:Name="ExportExcelButton"
                                  Label="تصدير إلى"
                                  Height="32" Width="130"
                                  VerticalAlignment="Center" HorizontalAlignment="Right"
                                  SizeMode="Normal" IconTemplate="{StaticResource ExcelIconTemplate}"
                                  Click="OnExportExcelClick"/>
        </Grid>

        <syncfusion:SfDataGrid x:Name="AlarmGrid" Grid.Row="1"
                               ItemsSource="{Binding AlarmVM.AlarmHistory}"
                               AllowSorting="True"
                               AllowFiltering="True"
                               RowHeight="28"
                               AutoGenerateColumns="False"
                               Margin="0">
            <syncfusion:SfDataGrid.Columns>
                <syncfusion:GridTextColumn MappingName="Timestamp" HeaderText="الوقت" Width="150" />
                <syncfusion:GridTextColumn MappingName="Source" HeaderText="المستشعر" Width="100" />
                <syncfusion:GridTextColumn MappingName="Message" HeaderText="الرسالة" Width="300" />
                <syncfusion:GridTextColumn MappingName="Status" HeaderText="الحالة" Width="80" />
            </syncfusion:SfDataGrid.Columns>
        </syncfusion:SfDataGrid>
    </Grid>
</UserControl>
