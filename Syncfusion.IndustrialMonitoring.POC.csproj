<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.6" />
    <PackageReference Include="Syncfusion.SfChart.WPF" Version="35.1.41" />
    <PackageReference Include="Syncfusion.SfGauge.WPF" Version="35.1.41" />
    <PackageReference Include="Syncfusion.SfGrid.WPF" Version="35.1.41" />
    <PackageReference Include="Syncfusion.Data.WPF" Version="35.1.41" />
    <PackageReference Include="Syncfusion.SfBulletGraph.WPF" Version="35.1.41" />
    <PackageReference Include="Syncfusion.SfSkinManager.WPF" Version="35.1.41" />
    <PackageReference Include="Syncfusion.Shared.WPF" Version="35.1.41" />
    <PackageReference Include="Syncfusion.Themes.Windows11Light.WPF" Version="35.1.41" />
    <PackageReference Include="Syncfusion.DataGridExcelExport.WPF" Version="35.1.41" />
    <PackageReference Include="Syncfusion.XlsIO.Wpf" Version="35.1.41" />
  </ItemGroup>

  <!-- Arabic localization: LogicalName ensures GridResourceWrapper finds Syncfusion.SfGrid.WPF.ar.resources -->
  <ItemGroup>
    <EmbeddedResource Update="Resources\Syncfusion.SfGrid.WPF.ar-SA.resx">
      <LogicalName>Syncfusion.SfGrid.WPF.ar.resources</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
